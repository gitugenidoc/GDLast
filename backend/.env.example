# Backend Environment Variables

# Server
NODE_ENV=development
PORT=3000
HOST=localhost

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/genidoc_hayat"

# JWT
JWT_SECRET=your_jwt_secret_change_this_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_this_in_production
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# CORS
FRONTEND_URL=http://localhost:5173

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Logger
LOG_LEVEL=debug

# Optional: Email (for future notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Optional: Redis (for future caching)
# REDIS_URL=redis://localhost:6379
