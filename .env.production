# Production Environment Configuration

## Cloudflare Worker Environment Variables

# Database
DATABASE_URL=your_d1_database_url
DB_BINDING=genidoc_db

# Authentication
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRY=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret

# API Keys
STRIPE_SECRET_KEY=sk_live_your_key
SENDGRID_API_KEY=your_sendgrid_key
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token

# External Services
FHIR_SERVER_URL=https://fhir.genidoc-hayat.com
FHIR_CLIENT_ID=your_fhir_client_id
FHIR_CLIENT_SECRET=your_fhir_secret

# CORS
CORS_ORIGIN=https://app.genidoc-hayat.com

# Email
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
EMAIL_FROM=noreply@genidoc-hayat.com

# File Storage
STORAGE_BUCKET=genidoc-files

# Analytics
ANALYTICS_TOKEN=your_analytics_token

# Feature Flags
ENABLE_FHIR_SYNC=true
ENABLE_SMART_CARDS=true
ENABLE_NOTIFICATIONS=true
ENABLE_AUDIT_LOGS=true

# Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60

# Security
BCRYPT_ROUNDS=12
SESSION_TIMEOUT=3600
